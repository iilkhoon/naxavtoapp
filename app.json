{
  "expo": {
    "name": "Naxçıvan Avto",
    "slug": "naxcivan-avto",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./icons/android-icon.png",
    "scheme": "naxcivan-avto",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./icons/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./icons/splash-dark.png",
        "backgroundColor": "#121212"
      }
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naxavtoapp.novoloji",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.naxavtoapp.novoloji",
      "adaptiveIcon": {
        "foregroundImage": "./icons/android-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "38110a1a-4c6a-4e2a-840a-8abfc3baa335"
      }
    }
  }
}